# ══════════════════════════════════════════════
# MEV SEARCHER BOT — ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in real values
# NEVER commit .env to git — it contains secrets
# ══════════════════════════════════════════════

# ── RPC ENDPOINTS ──────────────────────────────
# Get free key at: https://dashboard.alchemy.com
# WebSocket for mempool monitoring (low latency)
ALCHEMY_WS_URL=wss://eth-sepolia.g.alchemy.com/v2/YOUR_KEY_HERE

# HTTP for simulations and contract calls
ALCHEMY_HTTP_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY_HERE

# ── FLASHBOTS ──────────────────────────────────
# Sepolia testnet relay — safe for testing
FLASHBOTS_RELAY_URL=https://relay-sepolia.flashbots.net

# ── WALLET ─────────────────────────────────────
# Your searcher wallet private key
# NEVER use your main wallet — create a dedicated one
# NEVER share this or commit it to git
EXECUTOR_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# ── CONTRACTS ──────────────────────────────────
# FlashExecutor.sol deployed address on Sepolia
# Will be filled after Phase 6 deployment
EXECUTOR_CONTRACT_ADDRESS=0xYOUR_CONTRACT_ADDRESS_HERE

# ── NETWORK ────────────────────────────────────
# 11155111 = Sepolia testnet (safe, free)
# 1 = Ethereum mainnet (real money — Phase 8+)
CHAIN_ID=11155111

# ── BOT SETTINGS ───────────────────────────────
# Log verbosity: trace | debug | info | warn | error
LOG_LEVEL=info

# SQLite database file for storing opportunities and bundles
DB_PATH=./data/mev-bot.db

# Minimum net profit to pursue after gas costs (in wei)
# 1000000000000000 = 0.001 ETH
MIN_PROFIT_WEI=1000000000000000

# Maximum gas price willing to pay (in gwei)
# Bot will skip opportunities if gas is higher than this
MAX_GAS_PRICE_GWEI=50

# ── SAFETY ─────────────────────────────────────
# When true, the bot observes and detects normally but is physically
# incapable of submitting bundles. Use this to watch real mainnet
# mempool traffic without any risk of sending a transaction.
READ_ONLY_MODE=false

# ── FAULT INJECTION (testing only) ─────────────
# Probability (0..1) that a guarded RPC call throws a synthetic HTTP 429,
# used to prove the rate-limit recovery paths actually recover instead of
# crashing the process. Injection rotates through all five 429 error shapes
# ethers can produce, so every detection branch is exercised.
#   0.25  = fault a quarter of guarded RPC calls
#   0 / unset = disabled (normal operation)
# Leaving this on will make healthy runs look throttled — the bot logs a
# loud warning at startup whenever it is non-zero.
INJECT_FAULT_RATE=0

# ── SYNTHETIC OPPORTUNITY (testing only) ───────
# When true, one fabricated opportunity is pushed through the full pipeline
# at startup — record -> SQLite -> dashboard -> bundle build -> Anvil
# simulation -> relay gate — to prove every stage connects.
#
# It is stored with synthetic=1 and rendered with a red SYNTHETIC badge, and
# is deliberately NOT counted in the opportunities metric, so a test run can
# never be mistaken for a real detection.
#
# NOT a speed benchmark: fabricated data skips the network round-trips that
# dominate real latency. Latency numbers come only from real mempool traffic.
INJECT_OPPORTUNITY=false
