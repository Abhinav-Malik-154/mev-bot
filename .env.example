# ══════════════════════════════════════════════
# MEV SEARCHER BOT — ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in real values
# NEVER commit .env to git — it contains secrets
# ══════════════════════════════════════════════

# ── RPC ENDPOINTS ──────────────────────────────
# Get free key at: https://dashboard.alchemy.com
# WebSocket for mempool monitoring (low latency)
ALCHEMY_WS_URL=wss://eth-sepolia.g.alchemy.com/v2/YOUR_KEY_HERE

# HTTP for simulations and contract calls
ALCHEMY_HTTP_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY_HERE

# ── FLASHBOTS ──────────────────────────────────
# Sepolia testnet relay — safe for testing
FLASHBOTS_RELAY_URL=https://relay-sepolia.flashbots.net

# ── WALLET ─────────────────────────────────────
# Your searcher wallet private key
# NEVER use your main wallet — create a dedicated one
# NEVER share this or commit it to git
EXECUTOR_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# ── CONTRACTS ──────────────────────────────────
# FlashExecutor.sol deployed address on Sepolia
# Will be filled after Phase 6 deployment
EXECUTOR_CONTRACT_ADDRESS=0xYOUR_CONTRACT_ADDRESS_HERE

# ── NETWORK ────────────────────────────────────
# 11155111 = Sepolia testnet (safe, free)
# 1 = Ethereum mainnet (real money — Phase 8+)
CHAIN_ID=11155111

# ── BOT SETTINGS ───────────────────────────────
# Log verbosity: trace | debug | info | warn | error
LOG_LEVEL=info

# SQLite database file for storing opportunities and bundles
DB_PATH=./data/mev-bot.db

# Minimum net profit to pursue after gas costs (in wei)
# 1000000000000000 = 0.001 ETH
MIN_PROFIT_WEI=1000000000000000

# Maximum gas price willing to pay (in gwei)
# Bot will skip opportunities if gas is higher than this
MAX_GAS_PRICE_GWEI=50
